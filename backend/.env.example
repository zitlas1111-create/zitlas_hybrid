# ─────────────────────────────────────────────────────────────────────────────
# ZITLAS backend — environment template
#
# Copy to `backend/.env` and fill in real values:
#     cp backend/.env.example backend/.env
#
# `backend/.env` is gitignored and is NEVER included in any shared archive.
# This file contains variable NAMES and placeholders ONLY — no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI provider chain (services/groq_service.py) ─────────────────────────────
# Tried in order: Groq → Gemini → OpenRouter. At minimum GROQ_API_KEY is needed.
GROQ_API_KEY=
GROQ_API_KEY_DIET=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (defaults are set in code)
GROQ_PRIMARY_MODEL=
GROQ_FALLBACK_MODEL=
GROQ_STT_MODEL=

# ── Voice (ElevenLabs) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Provide EITHER the inline JSON (preferred on Railway/Render) OR a file path.
# Never commit the service-account file itself.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# KEY_SECRET is server-side only — never expose it to JS, Flutter or WebView.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── YouTube Data API ─────────────────────────────────────────────────────────
# Backend-only. Must never be placed in Flutter, frontend code, or the repo.
YOUTUBE_API_KEY=

# ── Support inbox (SMTP / IMAP) ──────────────────────────────────────────────
SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=
SUPPORT_INBOX=
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
SUPPORT_SMTP_TIMEOUT=
SUPPORT_SEND_DEADLINE=
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=
SUPPORT_IMAP_FOLDER=
SUPPORT_IMAP_POLL_SECONDS=
SUPPORT_IMAP_LOOKBACK_DAYS=

# ── Admin portal ─────────────────────────────────────────────────────────────
# Comma-separated. Gates the admin bootstrap + Google admin sign-in.
ZITLAS_ADMIN_EMAILS=
ZITLAS_ADMIN_UIDS=
ZITLAS_ENV=

# ── RAG / knowledge base tuning (optional) ───────────────────────────────────
ALLOW_MULTI_KB_SEARCH=
DISABLE_KB_PREWARM=

# ── Misc feature flags (optional) ────────────────────────────────────────────
CLIENT_TRIAL_MODE=
PLATFORM_CHARGES_FREE=

# ── Subscription limit overrides (services/entitlements.py) ──────────────────
# Optional. Omit to use the built-in defaults.
# Use "unlimited" for no cap.
ZITLAS_LIMIT_FREE_GOAL_RESET=
ZITLAS_LIMIT_FREE_MEAL_SWAP=
ZITLAS_LIMIT_FREE_RECIPE=
ZITLAS_LIMIT_PREMIUM_GOAL_RESET=
ZITLAS_LIMIT_PREMIUM_MEAL_SWAP=
ZITLAS_LIMIT_PREMIUM_RECIPE=
