rules_version = '2';

// ZITLAS — Production Firestore Security Rules
// Model: FIRESTORE_SECURITY_AUDIT.md, adjusted for the Phase-1 code changes
// (server-authoritative wallet/charge, backend cert/expert approval).
//
// Key design decisions:
//   * DEFAULT DENY — the final match/{document=**} denies everything unlisted.
//   * The BACKEND uses the Admin SDK (service account) which BYPASSES these
//     rules entirely, so all escrow/payment/approval writes keep working even
//     though clients are denied. Money + verification are backend-only here.
//   * Expert authorization is IDENTITY/RELATIONSHIP based (expertId==uid, or an
//     active personal_coaching row) — NOT a custom claim — so expert flows
//     never depend on claim propagation. Only ADMIN uses a custom claim
//     (request.auth.token.admin), needed for the admin certificate listing.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Create must not introduce any of these keys.
    function createOmits(fields) {
      return !request.resource.data.keys().hasAny(fields);
    }
    // Update must not change any of these keys.
    function updateKeeps(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // Update changed ONLY these keys (nothing else).
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Active, unexpired paid coaching relationship: caller is athleteId's coach.
    function relData(athleteId) {
      return get(/databases/$(database)/documents/personal_coaching/$(athleteId)).data;
    }
    function isActiveCoachOf(athleteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/personal_coaching/$(athleteId))
        && relData(athleteId).coachId == request.auth.uid
        && relData(athleteId).status == 'active'
        // endDateTs is the auto-expiry safety net (a relationship whose 30-day
        // term passed but whose status the sweep hasn't yet flipped). It was
        // ONLY added when routes/coaching.py's /accept started writing it —
        // any relationship accepted before that fix landed has no endDateTs
        // at all, and this used to hard-require it, so isActiveCoachOf was
        // UNCONDITIONALLY false for every one of those relationships: the
        // coach silently lost read access to meal_checkins/workout_checkins/
        // coaching_plans/chat/the athlete's own profile for a coaching
        // relationship the athlete's own app still showed as active — no
        // meal a real athlete snapped ever reached a real coach's Meal
        // Reviews for one of these. `status` on this doc is backend
        // (Admin SDK)-only — see the write rule below, a client may only ever
        // move it to 'reset'/'ended' — so trusting `status == 'active'` alone
        // when endDateTs is simply ABSENT cannot be spoofed; it only restores
        // access for relationships that predate the field. When endDateTs IS
        // present, the strict time check still applies, unchanged.
        && (!('endDateTs' in relData(athleteId)) || request.time < relData(athleteId).endDateTs);
    }
    // Chat membership via the participants array on the room doc.
    function chatParticipants(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
    }
    function isChatParticipant(roomId) {
      return signedIn() && (request.auth.uid in chatParticipants(roomId));
    }

    // ── users/{uid} (+ activity, weight_log subcollections) ──
    match /users/{uid} {
      allow read: if isUser(uid) || isActiveCoachOf(uid);
      // Create own doc at signup. wallet/membership are backend-only (money).
      // role/roles/expert_status ARE allowed at signup (the signup + Google
      // role-select flows set them) but constrained to NON-PRIVILEGED values:
      // never role/roles=='admin', never expert_status other than none/pending.
      // NOTE: no Security Rule grants privilege from these fields — admin uses
      // the custom claim, expert access is relationship/identity based — so
      // these are cosmetic routing fields; the value constraints below are
      // defense-in-depth, not the primary control.
      allow create: if isUser(uid)
        && createOmits(['wallet', 'membership'])
        && (!('role' in request.resource.data) || request.resource.data.role in ['athlete', 'expert'])
        && (!('roles' in request.resource.data) || !request.resource.data.roles.hasAny(['admin']))
        && (!('expert_status' in request.resource.data) || request.resource.data.expert_status in ['none', 'pending']);
      // After creation, the client may update profile/goal/cloud-sync data but
      // NEVER money or role/privilege fields (no self-escalation post-signup).
      allow update: if isUser(uid)
        && updateKeeps(['wallet', 'membership', 'role', 'roles', 'expert_status']);
      allow delete: if false;

      match /activity/{date} {
        allow read: if isUser(uid) || isActiveCoachOf(uid);
        allow write: if isUser(uid);
      }
      match /weight_log/{date} {
        allow read: if isUser(uid) || isActiveCoachOf(uid);
        allow write: if isUser(uid);
      }
    }

    // ── experts/{uid} — signed-in readable; self profile writes only ──
    // Trust fields (verified/approved/verification/verificationStatus) are
    // backend-only (set by the admin approval endpoint via Admin SDK).
    match /experts/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && createOmits(['verified', 'approved', 'verification', 'verificationStatus']);
      allow update: if isUser(uid)
        && updateKeeps(['verified', 'approved', 'verification', 'verificationStatus']);
      allow delete: if false;

      // PRIVATE coach notes — the coach's own working notes on an athlete.
      //
      // Deliberately NOT on coaching_plans/{athleteUid}: that document is
      // readable by the athlete, so a note stored there would be visible to
      // the person it is about. Stored under the COACH instead, where only
      // they can reach it. Note that `experts/{uid}` itself is world-readable
      // to signed-in users; a subcollection does NOT inherit that, and this
      // rule grants the owner alone.
      match /athlete_notes/{athleteId} {
        allow read, write: if isUser(uid);
      }
    }

    // ── expert_certificates ──
    match /expert_certificates/{certId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.expertId == request.auth.uid)
        || (signedIn() && resource.data.verificationStatus == 'verified');
      allow create: if signedIn()
        && request.resource.data.expertId == request.auth.uid
        && request.resource.data.verificationStatus in ['pending_review', 'pending'];
      // Owner may edit metadata but NOT the verification verdict; admin verdict
      // changes go through the backend (Admin SDK), never a client update.
      allow update: if signedIn()
        && resource.data.expertId == request.auth.uid
        && updateKeeps(['verificationStatus', 'verificationScore', 'rejectionReason', 'reviewedBy']);
      // Owner may delete their own cert; admin may delete any (dead-record
      // cleanup in the cert-audit maintenance tool).
      allow delete: if isAdmin() || (signedIn() && resource.data.expertId == request.auth.uid);
    }

    // ── expert_reviews — authored by the reviewing expert, read by its athlete ──
    match /expert_reviews/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.athleteId
            || request.auth.uid == resource.data.expertId);
      allow create: if signedIn() && request.resource.data.expertId == request.auth.uid;
      allow update: if signedIn() && resource.data.expertId == request.auth.uid;
      allow delete: if false;
    }

    // ── expert_ratings — the ATHLETE's 1-5 star rating OF an expert ──
    //
    // Not to be confused with `expert_reviews` above, which is the opposite
    // direction (the expert reviewing an athlete's diet plan).
    //
    // WRITES ARE BACKEND-ONLY. Every guarantee this data needs is a
    // cross-document, transactional one that rules cannot express: the
    // engagement must have actually ended, this athlete must have been in
    // it, no rating may already exist for it, and the expert's rating
    // aggregate must move atomically with the new row. All of that lives in
    // backend/routes/expert_ratings.py, which writes with the admin SDK.
    // Same posture as `users/{uid}.wallet`.
    //
    // READS ARE RESTRICTED TO THE TWO PARTIES, deliberately — even though
    // a published rating is public profile content. The document carries
    // `beforePhotoUrl`/`afterPhotoUrl` whether or not the athlete consented
    // to public display (they are stored either way, so the athlete keeps
    // their own record), so a signed-in-anyone read rule would hand a
    // non-consented transformation photo to any client willing to query the
    // collection directly — consent enforced only in the UI is not consent
    // enforced. Public profile display therefore goes through
    // GET /api/expert-ratings/expert/{id}, which omits non-consented photo
    // URLs from the response entirely.
    match /expert_ratings/{engagementId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.athleteId
            || request.auth.uid == resource.data.expertId);
      allow write: if false;
    }

    // ── review_requests — athlete owner + assigned expert ──
    match /review_requests/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == resource.data.expertId);
      // Create with paymentStatus only 'unpaid' (never a client-forged 'paid').
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('paymentStatus' in request.resource.data)
            || request.resource.data.paymentStatus == 'unpaid');
      // Athlete/expert may update workflow state, but NEVER the payment-state
      // flags — paymentStatus/walletTransactionId are set only by the backend
      // /api/payment/charge (Admin SDK), so a client can't forge a paid review.
      allow update: if signedIn()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == resource.data.expertId)
        && updateKeeps(['paymentStatus', 'walletTransactionId']);
      allow delete: if false;
    }

    // ── personal_coaching/{athleteUid} — escrow, backend-authoritative ──
    match /personal_coaching/{athleteUid} {
      allow read: if isUser(athleteUid)
        || (signedIn() && resource.data.coachId == request.auth.uid);
      // Athlete may ONLY retire the relationship (status + its timestamps +
      // who ended it and why).
      //
      // `endedBy` and `reason` were missing from this list while BOTH clients
      // write them (cprofile.js:4252, ExpertsRepository.endCoaching) — so
      // every End Coaching attempt was rejected with permission-denied and the
      // feature has never worked on either platform. They are provenance
      // fields on the athlete's own relationship; allowing them grants nothing
      // beyond the termination this rule already permits.
      allow update: if isUser(athleteUid)
        && changedOnly(['status', 'priorStatus', 'resetAt', 'endedAt', 'endedBy', 'reason'])
        && request.resource.data.status in ['reset', 'ended'];
      allow create, delete: if false;  // backend (Admin SDK) only
    }

    // ── personal_coach_requests — backend-only writes ──
    match /personal_coach_requests/{reqId} {
      // The expert is identified by `expertId` on THIS collection. It used to
      // read `coachId`, which these documents have never had — that field
      // exists only on personal_coaching (the relationship). The effect was
      // that no document ever satisfied the expert's half of this condition,
      // so the expert dashboard's
      // `where('expertId', '==', uid)` listener was rejected outright and a
      // new coaching request never reached the expert at all.
      allow read: if signedIn()
        && (resource.data.athleteId == request.auth.uid
            || resource.data.expertId == request.auth.uid);
      allow write: if false;  // backend (Admin SDK) only
    }

    // ── coaching_plans/{athleteUid} (+ versions) ──
    match /coaching_plans/{athleteUid} {
      allow read: if isUser(athleteUid) || isActiveCoachOf(athleteUid);
      // Only the COACH authors the plan. The athlete's single write is
      // `dietSelections` — which option they picked per meal, exactly what
      // coaching-workspace.js writes from the athlete side.
      //
      // The athlete used to have blanket write here, which let them rewrite
      // the plan their coach authored and then show it back as the coach's
      // prescription. Restricting it costs the athlete nothing they legitimately
      // do and closes a forgeable-record hole.
      //
      // The athlete's allowed fields, traced from every athlete-side write on
      // the website: `dietSelections` (coaching-workspace.js:998, diet.js:2043)
      // and the deletion of the legacy `athleteContext` pair that
      // coaching-reset.js:125 clears on a Goal Reset. Nothing else — and never
      // `diet` or `training`.
      allow create: if isActiveCoachOf(athleteUid)
        || (isUser(athleteUid) && createOmits(['diet', 'training']));
      allow update: if isActiveCoachOf(athleteUid)
        || (isUser(athleteUid)
            && changedOnly(['dietSelections', 'athleteContext', 'athleteContextUpdatedAt']));
      allow delete: if false;
      match /versions/{vid} {
        allow read: if isUser(athleteUid) || isActiveCoachOf(athleteUid);
        allow write: if isActiveCoachOf(athleteUid);
      }
    }

    // ── athlete<->coach records (athleteId owner + coachId participant) ──
    match /coaching_meal_requests/{id} {
      allow read: if signedIn()
        && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if signedIn()
        && (request.resource.data.athleteId == request.auth.uid
            || request.resource.data.coachId == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow delete: if false;
    }
    match /meal_checkins/{id} {
      // The athlete keeps their own photos forever. The COACH's access is
      // conditional on the relationship still being active — ending coaching
      // must revoke access to the athlete's meal photos, not just stop new
      // ones arriving. Nothing is deleted; an ex-coach simply can no longer
      // read them.
      allow read: if signedIn()
        && (resource.data.athleteId == request.auth.uid
            || (resource.data.coachId == request.auth.uid
                && isActiveCoachOf(resource.data.athleteId)));
      allow create: if signedIn() && request.resource.data.athleteId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.athleteId == request.auth.uid
            || (resource.data.coachId == request.auth.uid
                && isActiveCoachOf(resource.data.athleteId)));
      allow delete: if false;
    }
    // Same lifecycle as meal_checkins: the athlete keeps their own submissions
    // forever; the COACH's read/review access is revoked the moment coaching
    // ends (gated on the active relationship, not raw coachId), so an ex-coach
    // can no longer see or review workout check-ins.
    match /workout_checkins/{id} {
      allow read: if signedIn()
        && (resource.data.athleteId == request.auth.uid
            || (resource.data.coachId == request.auth.uid && isActiveCoachOf(resource.data.athleteId)));
      allow create: if signedIn() && request.resource.data.athleteId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.athleteId == request.auth.uid
            || (resource.data.coachId == request.auth.uid && isActiveCoachOf(resource.data.athleteId)));
      allow delete: if false;
    }
    match /health_alerts/{id} {
      allow read: if signedIn()
        && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.athleteId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow delete: if false;
    }

    // ── weekly_reviews/{athleteId_weekStart} ──
    match /weekly_reviews/{id} {
      allow read: if signedIn()
        && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.coachId == request.auth.uid;
      allow delete: if false;
    }

    // ── meal_snap_logs/{uid}/{date}/{logId} — personal AI log ──
    match /meal_snap_logs/{uid}/{date}/{logId} {
      allow read, write: if isUser(uid);
    }

    // ── chat_rooms + messages + calls (participant-gated) ──
    match /chat_rooms/{roomId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants);
      allow create: if signedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if signedIn() && (request.auth.uid in resource.data.participants);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isChatParticipant(roomId);
        // Sender must stamp their own uid (or an in-conversation system note).
        allow create: if isChatParticipant(roomId)
          && (request.resource.data.senderId == request.auth.uid
              || request.resource.data.senderType == 'system');
        allow update, delete: if false;
      }
      match /calls/{callId} {
        allow read: if isChatParticipant(roomId);
        allow create: if isChatParticipant(roomId);
        allow update: if isChatParticipant(roomId);
        allow delete: if false;
        match /{candidateSet}/{candId} {   // callerCandidates | calleeCandidates
          allow read: if isChatParticipant(roomId);
          allow create: if isChatParticipant(roomId);
          allow delete: if false;
        }
      }
    }

    // ── notifications — recipient-only read; mark-read only ──
    // ── device_tokens/{fcmToken} — per-device FCM registry ──
    // Keyed BY THE TOKEN so a physical device can only ever name ONE owning
    // uid: when a second account signs in on the same phone it OVERWRITES this
    // document, and the previous owner's device list no longer contains it.
    // That is what structurally prevents cross-account push delivery (a
    // uid-keyed subcollection would leave the old owner's copy alive and still
    // receiving). See core/notifications/fcm_service.dart + services/
    // notification_service.py, which resolves a user's devices with
    // where('uid','==',uid).
    //
    // A client may only ever claim a token FOR ITSELF (request.resource.data.uid
    // must be its own uid), so it can never point somebody else's device at its
    // own account or redirect another user's notifications. The backend reads
    // these with the Admin SDK, which bypasses rules, so no client read of
    // another user's registration is needed — or allowed.
    match /device_tokens/{fcmToken} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.fcmToken is string
        && request.resource.data.enabled is bool;
      // Logout cleanup — only the current owner may detach the device.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Live presence ───────────────────────────────────────
    // One document per DEVICE INSTALL, for athletes and experts alike, so
    // a user signed in on two phones is online while EITHER is in the
    // foreground and closing one does not black out the other.
    //
    // Read is open to any signed-in user. The payload is only
    // state + lastSeen — the same thing every chat app exposes — and
    // gating it behind a relationship lookup would cost a get() per
    // session document on every render.
    //
    // Write is hard-scoped to the owner: {uid} MUST be the caller, so
    // user A can never mark user B online. That, plus the serverTimestamp
    // requirement below, is what makes a green dot mean something.
    //
    // `lastSeen == request.time` forces FieldValue.serverTimestamp(). A
    // tampered client cannot post a far-future heartbeat and pin itself
    // green forever, because freshness is judged against a clock it does
    // not control.
    match /presence_sessions/{uid}/sessions/{deviceId} {
      allow read: if signedIn();
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['state', 'lastSeen'])
        && request.resource.data.state in ['online', 'offline']
        && request.resource.data.lastSeen == request.time;
      allow delete: if isUser(uid);
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // Cross-user by design (sender != recipient); constrained so it can only
      // create an unread notification with a string recipient.
      allow create: if signedIn()
        && request.resource.data.userId is string
        && request.resource.data.isRead == false;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && changedOnly(['isRead']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── coaching_notifications — toast; recipient reads/consumes ──
    // Real doc schema — BOTH clients (diet.js/coaching-workspace.js/day.js/
    // health-status.js on web; meal_checkin_repository.dart et al. on Flutter)
    // write { toId: <recipient>, fromId: <sender>, text, type, read }. The
    // coach/athlete toast listener queries `where('toId','==',uid)` and marks
    // read via `update({read:true})`. Reads MUST therefore gate on `toId`, not
    // on athleteId/coachId/recipientId (which these docs never carry) — the
    // earlier rule would have denied the live listener on both clients.
    match /coaching_notifications/{id} {
      allow read:   if signedIn() && resource.data.toId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.fromId == request.auth.uid;
      // Recipient marks their own received toast read (the only mutation the
      // listener performs).
      allow update: if signedIn() && resource.data.toId == request.auth.uid
                    && changedOnly(['read']);
      allow delete: if signedIn()
                    && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid);
    }

    // ── MONEY — client deny-all (backend Admin SDK bypasses) ──
    // ── Admin audit trail ───────────────────────────────────────
    // Server-only, in BOTH directions, deliberately including admins.
    //
    // Written exclusively by the Admin SDK (which bypasses these rules) and
    // read exclusively through GET /api/admin/audit-logs behind
    // require_admin. Granting an admin direct client access would let them
    // rewrite or delete their own history, which would defeat the only
    // purpose the collection has. There is no update/delete path anywhere in
    // the API either — the trail is append-only by construction, not by
    // convention.
    match /admin_audit_logs/{id} { allow read, write: if false; }

    match /wallet_transactions/{id} { allow read, write: if false; }
    match /razorpay_orders/{id}     { allow read, write: if false; }

    // ── DEFAULT DENY ──
    match /{document=**} { allow read, write: if false; }
  }
}
