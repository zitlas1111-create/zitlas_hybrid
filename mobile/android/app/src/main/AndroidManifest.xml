<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for Firebase and every FastAPI call. Flutter's generated
         debug/ and profile/ manifests declare this too, but ONLY for the
         hot-reload channel — without it here, release builds ship with no
         network access at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Geo-Aware Food Intelligence (services/location_food_engine.py) —
         city/state resolution only, never continuous tracking, so coarse is
         sufficient (mirrors geo-location.js's enableHighAccuracy:false). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Runtime-requested on Android 13+ (API 33) for FCM notifications to
         actually display; older versions grant this at install time. Also
         covers the LOCAL step-milestone notifications (same OS permission —
         flutter_local_notifications and FCM share one notification channel
         permission on Android). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Step tracking, source #1: Health Connect. READ only — ZITLAS never
         writes step records back, and no other health data type is requested
         (privacy: request exactly what the step counter needs). -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>

    <!-- Step tracking, source #2 (fallback): the hardware TYPE_STEP_COUNTER
         sensor. Required from Android 10 (API 29) to read it at all. The chip
         counts steps with the app dead/locked, which is what makes
         background capture possible without a foreground service. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <!-- Microphone for coach voice/video calls inside the Personal Coaching
         WebView (webrtc-call.js getUserMedia). Zino's own voice mode used to
         share this permission and has been removed; the WebView still needs
         it, so the line stays. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Camera for coach voice/video calls inside the Personal Coaching WebView
         (webrtc-call.js getUserMedia). The native meal-snap uses the system
         camera app via image_picker and needs no permission of its own; this
         line exists purely so the WebView can grant a getUserMedia camera
         request during a live call. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Zino's daily reminders are handed to AlarmManager, which forgets
         everything on reboot. This lets flutter_local_notifications' boot
         receiver (registered below) restore the schedule, so reminders keep
         working after the phone restarts without the app being opened. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 12+ gates exact alarms. Without one, a 09:00 reminder can be
         deferred by Doze to an arbitrary later time.

         SCHEDULE_EXACT_ALARM only — deliberately NOT USE_EXACT_ALARM. The
         latter is auto-granted but Play restricts it to apps whose CORE
         function is an alarm clock, timer or calendar; a fitness app that
         declares it fails policy review. SCHEDULE_EXACT_ALARM is requested at
         runtime instead, and ZinoNotificationScheduler falls back to inexact
         scheduling if the athlete declines — a reminder inside a window beats
         no reminder at all. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false"/>

    <application
        android:label="ZITLAS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect permission rationale target, Android 13 and
                 below. Without it the HC permission sheet can refuse to
                 appear. (Android 14+ uses the activity-alias below.) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- Health Connect requires the app to declare where it explains WHY
             it wants health data (Android 14+, where HC is part of the
             system, uses this activity-alias; the Android 13-and-below
             equivalent is the ACTION_SHOW_PERMISSIONS_RATIONALE
             intent-filter on MainActivity above). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

        <!-- Reschedules Zino's daily reminders after a reboot. Without this
             receiver every scheduled notification is silently lost when the
             phone restarts, and the athlete simply stops hearing from Zino. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>

        <!-- Captures the step counter at local midnight so a completed day has
             an exact closing total even when ZITLAS was never opened. Plain
             Kotlin, no Flutter engine — see StepDayBoundary.kt. -->
        <receiver
            android:name=".StepDayBoundaryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zitlas.app.STEP_DAY_BOUNDARY"/>
            </intent-filter>
        </receiver>

        <!-- AlarmManager drops every alarm on reboot; this re-arms the midnight
             capture without the athlete having to reopen the app. -->
        <receiver
            android:name=".StepBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- FCM fallback channel. Used ONLY if a message somehow arrives
             without an android.notification.channel_id (Android 8+ DROPS such a
             notification silently otherwise). The real per-category channels
             (zitlas_messages / _coaching / _meal_reviews / _plans / _general)
             are created by FcmService at runtime and are what the backend
             targets — see services/push_service.py's channel constants. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="zitlas_general" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Package visibility (Android 11+): without this, the Health Connect
         availability check can't see the provider and always reports
         "unavailable". -->
    <queries>
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
    </queries>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
